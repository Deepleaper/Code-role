{
  "schema_version": "0.1",
  "role": "product-prd",
  "milestone": "template",
  "packet_version": "packet-v001",
  "status": "draft",
  "created_at": "YYYY-MM-DD",
  "updated_at": "YYYY-MM-DD",
  "summary": "Template manifest for a Product / PRD packet.",
  "artifact_policy": {"primary_artifact_from_assignment": true, "required_primary_artifact_count": 1, "documents_are_optional_annexes": true},
  "documents": [
    {
      "path": "product-brief.md",
      "type": "product_brief",
      "required": false,
      "description": "Product problem, user, scope, and decision summary."
    },
    {
      "path": "prd.md",
      "type": "prd",
      "required": false,
      "description": "Buildable product requirements."
    },
    {
      "path": "acceptance-criteria.md",
      "type": "acceptance_criteria",
      "required": false,
      "description": "Criteria downstream tests and review should verify."
    },
    {
      "path": "non-goals.md",
      "type": "non_goals",
      "required": false,
      "description": "Explicitly rejected scope and boundaries."
    },
    {
      "path": "decision-log.md",
      "type": "decision_log",
      "required": false,
      "description": "Product decisions and evidence behind them."
    }
  ],
  "input_packets": [],
  "source_scopes": [
    "docs/workflow/source-map.md",
    "docs/workflow/roles/product-prd/product-prd-output-standard.md",
    "assignment-named upstream artifacts"
  ],
  "return_to": "workflow-orchestrator",
  "open_questions": [],
  "blocked": false,
  "required_confirmations": []
}
