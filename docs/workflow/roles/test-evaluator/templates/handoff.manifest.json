  "documents": [
    {"path": "evaluation-baseline.md", "type": "evaluation_baseline", "required": true, "description": "Evaluation mechanism, metrics, benchmark data, industry references, and baseline confirmation."},
    {"path": "test-plan.md", "type": "test_plan", "required": true, "description": "Test plan mapped to acceptance criteria."},
    {"path": "test-results.md", "type": "test_results", "required": true, "description": "Test results."},
    {"path": "regression-matrix.md", "type": "regression_matrix", "required": true, "description": "Regression coverage matrix."},
    {"path": "failure-analysis.md", "type": "failure_analysis", "required": true, "description": "Failure analysis."},
    {"path": "quality-gate.md", "type": "quality_gate", "required": true, "description": "Quality gate decision."}
  ],
  "input_packets": [
    {
      "role": "implementer",
      "milestone": "template",
      "packet_version": "packet-v001",
