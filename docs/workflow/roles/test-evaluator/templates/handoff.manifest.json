      "consumption_status": "accepted_as_input"
    }
  ],
  "source_scopes": [
    "docs/workflow/source-map.md",
    "docs/workflow/roles/test-evaluator/test-evaluator-output-standard.md",
    "user-confirmed evaluation mechanism and baseline",
    "approved industry/common-consensus evaluation references when available",
    "upstream implementer packet"
  ],
  "evaluation_baseline": {
    "mechanism_confirmed": false,
    "industry_reference_status": "unknown",
